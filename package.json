{
  "name": "icop-cyberbusiness-360",
  "version": "1.0.1",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "build:cf": "npm run test:pricing && npm run test:quotation-docx && npm run test:post-po && npm run test:boq && npm run test:boq-domain && npm run test:ai && npm run test:boq-workflow && npm run test:sales && npm run test:sales-transactions && npm run test:scoping-upload && npm run test:marketing && npm run test:india-negative && npm run test:runtime-compat && opennextjs-cloudflare build",
    "deploy:cf": "opennextjs-cloudflare deploy",
    "preview:cf": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "test:consolidation": "node --test tests/marketing-sales-consolidation.test.cjs tests/marketing-sales-atomic-bridge.test.cjs tests/marketing-sales-runtime-integration.test.cjs tests/india-cloudflare-access-real-uat-guard.test.cjs tests/marketing-sales-remote-preflight-guard.test.cjs",
    "test:layout": "node --experimental-strip-types --test tests/quotation-layout.test.cjs tests/ai-chat-format.test.cjs",
    "test:pricing": "node --test tests/pricing-technical-writer.test.cjs",
    "test:boq": "node --test tests/boq-export.test.cjs",
    "test:quotation-docx": "node --experimental-strip-types --test tests/quotation-docx.test.cjs",
    "test:post-po": "node --experimental-strip-types --test tests/post-po-documents.test.cjs",
    "test:boq-domain": "node --test tests/boq-domain.test.cjs",
    "test:ai": "node --test tests/ai-config-security.test.cjs",
    "test:boq-workflow": "node --test tests/boq-workflow.test.cjs",
    "test:sales": "node --experimental-strip-types --test tests/sales-workflow.test.cjs tests/sales-post-po-integration.test.cjs tests/sales-loss-report.test.cjs tests/sales-multirole-simulation.test.cjs tests/sales-journey.test.cjs tests/sales-procurement.test.cjs tests/sales-submission.test.cjs tests/sales-award.test.cjs",
    "test:scoping-upload": "node --experimental-strip-types --test tests/scoping-upload.test.cjs",
    "test:marketing": "node --experimental-strip-types --test tests/marketing-lead-flow.test.cjs tests/marketing-d1-migration.test.cjs tests/marketing-idempotency.test.cjs tests/marketing-campaigns.test.cjs",
    "test:india-negative": "node --experimental-strip-types --test tests/india-negative-uat.test.cjs tests/india-negative-api.test.cjs",
    "test:browser-http-uat": "node --test tests/browser-http-uat.test.cjs tests/sales-lifecycle-browser.cjs",
    "test:runtime-compat": "node --test tests/next16-compat.test.cjs",
    "test:sales-transactions": "node --test tests/sales-lifecycle-transactions.test.cjs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^0.475.0",
    "next": "16.4.2",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "tailwind-merge": "^2.6.0",
    "jose": "^6.1.0",
    "jszip": "^3.10.1",
    "unpdf": "1.8.1"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.12",
    "wrangler": "4.151.2",
    "@types/node": "^22.13.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "playwright": "1.55.0"
  }
}
