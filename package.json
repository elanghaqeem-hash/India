{
  "name": "icop-cyberbusiness-360",
  "version": "1.0.1",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "build:cf": "npm run test:pricing && npm run test:quotation-docx && npm run test:post-po && npm run test:boq && npm run test:boq-domain && npm run test:ai && npm run test:boq-workflow && npm run test:sales && npm run test:scoping-upload && npm run test:marketing && opennextjs-cloudflare build",
    "deploy:cf": "opennextjs-cloudflare deploy",
    "preview:cf": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "test:layout": "node --test tests/quotation-layout.test.cjs",
    "test:pricing": "node --test tests/pricing-technical-writer.test.cjs",
    "test:boq": "node --test tests/boq-export.test.cjs",
    "test:quotation-docx": "node --experimental-strip-types --test tests/quotation-docx.test.cjs",
    "test:post-po": "node --experimental-strip-types --test tests/post-po-documents.test.cjs",
    "test:boq-domain": "node --test tests/boq-domain.test.cjs",
    "test:ai": "node --test tests/ai-config-security.test.cjs",
    "test:boq-workflow": "node --test tests/boq-workflow.test.cjs",
    "test:sales": "node --experimental-strip-types --test tests/sales-workflow.test.cjs tests/sales-post-po-integration.test.cjs tests/sales-loss-report.test.cjs tests/sales-multirole-simulation.test.cjs tests/sales-journey.test.cjs tests/sales-procurement.test.cjs tests/sales-submission.test.cjs",
    "test:scoping-upload": "node --experimental-strip-types --test tests/scoping-upload.test.cjs",
    "test:marketing": "node --experimental-strip-types --test tests/marketing-lead-flow.test.cjs tests/marketing-d1-migration.test.cjs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^0.475.0",
    "next": "15.5.28",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tailwind-merge": "^2.6.0",
    "jose": "^6.1.0",
    "jszip": "^3.10.1",
    "unpdf": "1.8.1"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.12",
    "wrangler": "4.151.2",
    "@types/node": "^22.13.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3"
  }
}
